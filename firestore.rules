rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Bootstrap: without this the very first admin could never be created,
    // since promoting to admin already requires being an admin.
    function isBootstrapAdmin() {
      return request.auth != null &&
        request.auth.token.email in ['usmansiddique692@gmail.com'];
    }

    function isAdmin() {
      return isBootstrapAdmin() || (request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // App users, their role (admin / agent) and the list of app sections they
    // may open (`tabs`). Users self-register as 'agent' on first login; only
    // an admin can change anyone's role or section access.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if isAdmin() || (request.auth != null && request.auth.uid == userId
        && request.resource.data.role == 'agent');
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /renewals/{renewalId} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }
    // Renewal requests / pipeline cases created and managed entirely in-app.
    match /requests/{requestId} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }
    // Vehicle master data, split into <1MiB chunks (reassembled client-side).
    // Uploaded once via a direct authenticated-only REST upload (2026-07-15).
    match /vehicle_data_chunks/{chunkId} {
      allow read: if request.auth != null;
      allow create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
