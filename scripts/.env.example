# Copy this file to .env (same folder) and fill in a real renewal-tracker
# app account (the same email/password you use to log into the app).
# Used only by sync-requests.js on this machine. Never commit .env.
SYNC_EMAIL=you@example.com
SYNC_PASSWORD=your-password

